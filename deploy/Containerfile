# Pulse app image: backend + built frontend + built add-in, one Node process.
#
# Built from the repository root (the build context has to see every workspace):
#   podman build -f deploy/Containerfile -t pulse-app .
#
# The repo-root .dockerignore keeps uploads, backups, .env files and quiz-spike output out
# of the build context. Student work never goes into an image.

# The full (not -slim) Node image on purpose: Prisma's engine needs OpenSSL, which -slim
# lacks, and installing it would mean the VM also has to reach the Debian mirrors. This
# way a build needs only Docker Hub and the npm registry.
FROM docker.io/library/node:22-bookworm AS build
WORKDIR /src

# Manifests first, so a code-only change reuses the npm ci layer.
COPY package.json package-lock.json ./
COPY shared/package.json shared/
COPY backend/package.json backend/
COPY frontend/package.json frontend/
COPY addin/package.json addin/
RUN npm ci --no-audit --no-fund

COPY . .
RUN npm run build && npm prune --omit=dev --no-audit --no-fund

FROM docker.io/library/node:22-bookworm
WORKDIR /app
ENV NODE_ENV=production \
    PORT=3001 \
    UPLOAD_DIR=/data/uploads

COPY --from=build /src/package.json /src/package-lock.json ./
COPY --from=build /src/node_modules ./node_modules
COPY --from=build /src/shared ./shared
COPY --from=build /src/backend ./backend
COPY --from=build /src/frontend/dist ./frontend/dist
COPY --from=build /src/addin/dist ./addin/dist

# Not root inside the container. With rootless Podman the container's root is already an
# unprivileged user on the host; this is the second layer.
RUN mkdir -p /data/uploads && chown -R node:node /data
USER node
EXPOSE 3001

# Same start as railway.toml: apply pending migrations, then serve.
CMD ["sh", "-c", "npm run db:migrate:deploy && exec node backend/dist/index.js"]
