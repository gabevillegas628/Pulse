# Copy to deploy/.env on the server and fill in. deploy/.env is git-ignored; keep it that
# way (chmod 600). Generate secrets with:  openssl rand -hex 32

# Public hostname OIT assigns, e.g. pulse.example.rutgers.edu. No scheme.
PULSE_DOMAIN=

POSTGRES_PASSWORD=
JWT_SECRET=
JWT_EXPIRES_IN=24h
VISION_TOKEN=
PROFESSOR_INVITE_CODE=

# AI features: claude or gemini. With the key or project for that provider blank, the AI
# features are off.
AI_PROVIDER=claude
ANTHROPIC_API_KEY=

# Gemini on Vertex AI, in the Google Cloud project the university's agreement covers.
# Put the service account's key file in deploy/secrets/ (git-ignored) as gcp-key.json.
GOOGLE_CLOUD_PROJECT=
GOOGLE_CLOUD_LOCATION=global
GOOGLE_APPLICATION_CREDENTIALS=/run/secrets/gcp-key.json

# Per-role model overrides (MODEL_TEXT, MODEL_STRUCTURE, ...): see ROLES in
# backend/src/ai/llm.ts. They apply to whichever provider is active.

# Password-reset email (Brevo). Blank: reset links are written to the server log instead.
BREVO_API_KEY=
EMAIL_USER=
EMAIL_FROM_NAME=Pulse
PASSWORD_RESET_TTL_MINUTES=60

# Optional: raises the GitHub rate limit for the textbook pages.
GITHUB_TOKEN=
