# HTTPS front end. Caddy gets and renews the certificate itself (Let's Encrypt), which
# needs inbound 80 and 443 from the Internet and outbound 443 to acme-v02.api.letsencrypt.org.
#
# If OIT issues the certificate instead, put the files in /var/lib/pulse/certs and replace
# the `tls` line with:  tls /certs/fullchain.pem /certs/privkey.pem

{$PULSE_DOMAIN} {
	tls {$ACME_EMAIL}
	encode gzip

	# Scans arrive as multi-page PDFs; the app itself caps them at 300 MB (quizScans.routes.ts).
	request_body {
		max_size 310MB
	}

	# The app listens on localhost only. Caddy runs on the host network so the app sees
	# real client addresses (rate limiting keys on them); X-Forwarded-For is set here and
	# trusted for exactly one hop (`trust proxy 1` in app.ts).
	reverse_proxy 127.0.0.1:3001

	header {
		Strict-Transport-Security "max-age=31536000"
		-Server
	}
}
