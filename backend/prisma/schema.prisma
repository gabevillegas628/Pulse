generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professor {
  id            String    @id @default(cuid())
  email         String    @unique
  passwordHash  String
  name          String
  // Admin is a bit on a professor, not a second kind of account: requireProfessor
  // re-reads this row on every request, so the bit lives only in the database and
  // granting or revoking it takes effect on the next request, with no token to chase.
  isAdmin       Boolean   @default(false)
  // Deactivation, deliberately not deletion: Class cascades from Professor, so a
  // delete takes a semester of education records with it. A deactivated professor
  // keeps every row; login and every outstanding token stop working instead.
  deactivatedAt DateTime?
  createdAt     DateTime  @default(now())
  updatedAt     DateTime  @updatedAt
  classes       Class[]
  quizContent   QuizContent[]
  quizBatches   QuizBatch[]
}

model Student {
  id           String               @id @default(cuid())
  netId        String               @unique
  email        String               @unique
  passwordHash String
  createdAt    DateTime             @default(now())
  updatedAt    DateTime             @updatedAt
  enrollments  Enrollment[]
  responses    Response[]
  extensions   DeadlineExtension[]
  resetTokens  PasswordResetToken[]
}

// A pending 'forgot password' link. Rows are the tokens themselves, not a field on
// Student, so a student can be issued a second link without the first one being
// silently overwritten mid-flight — both exist, and claiming either retires the rest.
model PasswordResetToken {
  id        String    @id @default(cuid())
  studentId String
  student   Student   @relation(fields: [studentId], references: [id], onDelete: Cascade)
  // The SHA-256 of the token, never the token. A read of this table — a backup, a
  // Studio window, a leaked dump — must not hand anyone a working reset link.
  // SHA-256 rather than bcrypt because the token is 32 random bytes and there is
  // nothing to guess, and because the lookup has to be an indexed read of one row
  // rather than a scan that bcrypt-compares every outstanding token.
  tokenHash String    @unique
  expiresAt DateTime
  // Set when the link is spent. Kept rather than deleted so a student who clicks
  // their emailed link twice is told it was already used instead of that it never
  // existed, which is the difference between a clear message and a support email.
  usedAt    DateTime?
  createdAt DateTime  @default(now())

  @@index([studentId])
  // The sweep that deletes dead rows orders by this.
  @@index([expiresAt])
}

model Class {
  id                String         @id @default(cuid())
  professorId       String
  // Restrict, not Cascade: deleting a professor must never silently take a
  // semester of responses with it. There is deliberately no path in the app that
  // deletes a professor — admins deactivate instead — so this guards raw SQL,
  // Prisma Studio, and future scripts: transfer or delete the classes first.
  professor         Professor      @relation(fields: [professorId], references: [id], onDelete: Restrict)
  name              String
  description       String?
  joinCode          String         @unique
  textbookRepo      String?
  textbookPath      String?
  textbookBranch    String?
  // Default for live AI theming of FREE_TEXT answers. Per-question `liveThemes`
  // overrides it; off by default so no lecture starts calling an LLM unasked.
  liveThemesDefault Boolean        @default(false)
  // Default for auto-closing questions once answers stop arriving. Per-question
  // `autoClose` overrides it; off by default so no lecture starts refusing answers unasked.
  autoCloseDefault  Boolean        @default(false)
  // Default for grading free text on effort instead of understanding. Per-question
  // `effortGrading` overrides it. A course tends to take one stance or the other for
  // the whole term, which is why this lives on the class and not only on questions.
  effortGradingDefault Boolean     @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  assignments       Assignment[]
  enrollments       Enrollment[]
  sections          Section[]
  textbookViews     TextbookView[]
}

model TextbookView {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapterFilename String
  viewedAt        DateTime @default(now())

  @@index([classId])
  @@index([classId, chapterFilename])
}

model Section {
  id          String       @id @default(cuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  joinCode    String       @unique
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  runs        SessionRun[]
  skips       QuestionSkip[]

  @@index([classId])
}

model Enrollment {
  studentId  String
  classId    String
  sectionId  String?
  // May answer in any section of this class, not only their own.
  //
  // Students move between sections for work and family reasons, and a professor who does not
  // mind has no way to say so: the gate matches on `sectionId` alone, so splitting a class
  // into sections would turn away someone sitting in the room. Set per student per class,
  // which is the right grain — floating in one class says nothing about another.
  //
  // Their `sectionId` still stands and is still what the roster and the participation
  // denominator count, so attending the other section makes the numerator there exceed the
  // total by one. Accepted deliberately: the denominator is "registered", not "present", and
  // only modelling attendance would fix it.
  anySection Boolean  @default(false)
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id])
  enrolledAt DateTime @default(now())

  @@id([studentId, classId])
  // The primary key leads with studentId, so it cannot serve "who is in this class" —
  // the query behind every roster load. Without this that read scans the table.
  @@index([classId])
}

// ───── IN_CLASS ──────────────────────────────────────────────────────────────

model Session {
  id         String          @id @default(cuid())
  classId    String
  class      Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  accessCode String          @unique
  status     SessionStatus   @default(DRAFT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  questions  Question[]
  groups     QuestionGroup[]
  runs       SessionRun[]

  @@index([classId])
}

model SessionRun {
  id        String        @id @default(cuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section?      @relation(fields: [sectionId], references: [id])
  status    SessionStatus @default(OPEN)
  openedAt  DateTime      @default(now())
  closedAt  DateTime?
  createdAt DateTime      @default(now())
  responses Response[]
  themeSets ThemeSet[]

  @@index([sessionId])
  @@index([sectionId])
}

// ───── HOMEWORK ──────────────────────────────────────────────────────────────

model Assignment {
  id         String              @id @default(cuid())
  classId    String
  class      Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  status     SessionStatus       @default(OPEN)
  deadline   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  questions  Question[]
  groups     QuestionGroup[]
  extensions DeadlineExtension[]

  @@index([classId])
}

model DeadlineExtension {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  deadline     DateTime
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
}

model QuestionGroup {
  id           String      @id @default(cuid())
  sessionId    String?
  session      Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  text         String?
  order        Int
  createdAt    DateTime    @default(now())
  questions    Question[]

  @@index([sessionId])
  @@index([assignmentId])
}

// ───── Shared ──────────────────────────────────────────────────────────────

enum SessionStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum QuestionType {
  FREE_TEXT
  MULTIPLE_CHOICE
  RATING
  YES_NO
  NUMERIC
  MULTI_SELECT
  ORDERING
  STRUCTURE
  BLANKS
}

model Question {
  id            String         @id @default(cuid())
  sessionId     String?
  session       Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId       String?
  group         QuestionGroup? @relation(fields: [groupId], references: [id])
  title         String?
  text          String
  type          QuestionType   @default(FREE_TEXT)
  options       Json?
  order         Int
  accessCode    String         @unique
  correctAnswer String?
  tolerance     Float?
  unit          String?
  // A diagram or photo shown above the answer input, as a "/uploads/<name>" path
  // this server minted. Never an external URL: it goes straight into an <img src>.
  imageUrl      String?
  // null = inherit Class.liveThemesDefault. FREE_TEXT only; ignored for other types.
  liveThemes    Boolean?
  // null = inherit Class.autoCloseDefault. Unlike liveThemes this applies to every
  // question type â the answer key is most worth protecting on the objective ones.
  autoClose     Boolean?
  // null = inherit Class.effortGradingDefault. FREE_TEXT only; ignored for other types.
  // Switches the AI grader from "did they understand it" to "did they really try",
  // so a wrong-but-genuine answer earns full credit and a keysmash does not.
  effortGrading Boolean?
  responses     Response[]
  themeSets     ThemeSet[]
  skips         QuestionSkip[]

  @@index([sessionId])
  @@index([assignmentId])
  @@index([groupId])
}

// A session question the professor decided not to ask in a section, after the slide with
// its QR code was already in the deck. Answers that arrive anyway are kept but count for
// nothing: not as presented, not in the max, not as participation, not as work to score.
//
// Keyed to the section rather than the run, because a section is what grading groups by
// and what a professor thinks in. A run is only a press of Open, and a close-and-reopen
// mid-lecture would otherwise shed the skip and let stray answers count again.
//
// sectionId is null for runs opened for everyone, which is every run in a class without
// sections. Deliberately no unique constraint: Postgres treats nulls as distinct, so it
// would not hold for the common case anyway. Skipping is idempotent by construction — the
// route clears before it writes, and every reader asks only whether a row exists.
model QuestionSkip {
  id         String   @id @default(cuid())
  questionId String
  question   Question @relation(fields: [questionId], references: [id], onDelete: Cascade)
  sectionId  String?
  section    Section? @relation(fields: [sectionId], references: [id], onDelete: Cascade)
  createdAt  DateTime @default(now())

  @@index([questionId])
}

model Response {
  id           String         @id @default(cuid())
  questionId   String
  studentId    String
  runId        String?
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  run          SessionRun?    @relation(fields: [runId], references: [id])
  responseText String
  wordCount    Int
  isFlagged    Boolean        @default(false)
  aiScore      Float?
  // The grader's one-line justification for aiScore. Persisted because a score below
  // full credit is contestable — under effort grading it reads as "you didn't really
  // try" — and a professor asked about it a week later needs the reason to still exist.
  // Cleared whenever a professor overrides the score by hand: it described the AI's
  // number, not theirs.
  aiReason     String?
  isDraft      Boolean        @default(true)
  submittedAt  DateTime       @default(now())
  theme        ResponseTheme?

  @@unique([questionId, studentId])
  @@index([questionId])
  @@index([runId])
  @@index([studentId])
}

// ───── Live AI themes ──────────────────────────────────────────────────────────
//
// Categories for a FREE_TEXT question, derived once from the first answers and then
// assigned to each subsequent answer as it lands. See live_ai_themes_spec.md.
//
// Keyed to the run, not the question: re-teaching the same session next term starts
// from a clean set rather than inheriting last term's categories.

enum ThemeSetStatus {
  WAITING // enabled, not enough answers yet
  BOOTSTRAPPING // deriving categories now
  ACTIVE // categories exist, classifying incrementally
  RECLUSTERING // re-deriving categories
  FAILED // gave up; the projector falls back to plain counts
}

enum ThemeSource {
  AI
  PROFESSOR
}

model ThemeSet {
  id              String          @id @default(cuid())
  questionId      String
  runId           String
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  run             SessionRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status          ThemeSetStatus  @default(WAITING)
  model           String? // which model produced the categories, for the record
  bootstrapN      Int? // how many answers seeded it
  classifyCalls   Int             @default(0) // cost ceiling counter
  lastClusteredAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  categories      ThemeCategory[]

  @@unique([questionId, runId])
  @@index([runId])
}

model ThemeCategory {
  id          String          @id @default(cuid())
  themeSetId  String
  themeSet    ThemeSet        @relation(fields: [themeSetId], references: [id], onDelete: Cascade)
  label       String
  description String
  order       Int
  // Exactly one per set, created server-side and never invented by the model.
  // Low-confidence answers land here instead of being forced into a wrong bin.
  isOther     Boolean         @default(false)
  assignments ResponseTheme[]

  @@index([themeSetId])
}

// A response's category assignment. Deliberately a separate table rather than a column
// on Response: Response is hot and widely selected â including by the identity-stripped
// /addin/live payload â so an AI-feature foreign key there would widen every query that
// touches it. Counts come from a groupBy here, so they can never go stale.
model ResponseTheme {
  id         String        @id @default(cuid())
  responseId String        @unique
  categoryId String
  response   Response      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  category   ThemeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  confidence Float?
  source     ThemeSource   @default(AI)
  assignedAt DateTime      @default(now())

  @@index([categoryId])
}

// ─── Quiz grader (docs/quiz-grader) ───────────────────────────────────────────

enum QuizContentKind {
  KEY        // a pathway's answers: enzymes, cofactors, intermediates and their features
  LAYOUT     // where each blank sits on one printed form
  ASSESSMENT // which blanks a quiz grades, for how many points, in which versions
}

// One answer key, layout or assessment, kept as the YAML a professor imports and
// exports. The source text is the record, not a parse of it: it carries comments and
// hand formatting, and the app edits it by splicing only the changed text
// (src/quizGrader/yamlPatch.ts), so an exported file diffs cleanly against the one
// that was imported. Parsing and validating happen on every read.
//
// Owned by a professor rather than a class: a glycolysis key outlives a semester and
// serves every section that gives the quiz. Assessments name their key and layout by
// slug, as the YAML does, resolved within the same professor's content.
model QuizContent {
  id          String          @id @default(cuid())
  professorId String
  // Restrict, like Class: no path in the app deletes a professor.
  professor   Professor       @relation(fields: [professorId], references: [id], onDelete: Restrict)
  kind        QuizContentKind
  // The YAML's own name for itself: `pathway:` for a key, `layout:`, `assessment:`.
  slug        String
  source      String
  // Layouts only: the blank form, as a PDF, one page per version. What the box editor
  // draws on and what printing stamps corner markers onto. Small (a quiz page is tens of
  // kilobytes), so it lives in the row rather than on the upload volume.
  pdf         Bytes?
  createdAt   DateTime        @default(now())
  updatedAt   DateTime        @updatedAt

  @@unique([professorId, kind, slug])
  batches     QuizBatch[]
  decisions   QuizGroupDecision[]
}

// One upload of scanned quizzes for an assessment: a PDF from the copier, or a photo.
// The page images are student work (names, NetIDs, handwriting). They live under a
// dot-directory of the upload volume that is never served statically, and only the
// owning professor's authenticated requests read them.
model QuizBatch {
  id           String          @id @default(cuid())
  professorId  String
  professor    Professor       @relation(fields: [professorId], references: [id], onDelete: Restrict)
  // Restrict: an assessment with scans cannot be deleted until its scans are.
  assessmentId String
  assessment   QuizContent     @relation(fields: [assessmentId], references: [id], onDelete: Restrict)
  fileName     String
  // The upload as the vision service holds it, until every page has been fetched.
  visionDocId  String?
  pageCount    Int
  createdAt    DateTime        @default(now())
  updatedAt    DateTime        @updatedAt
  pages        QuizPage[]

  @@index([assessmentId])
}

enum QuizPageStatus {
  PENDING       // waiting for the worker
  PROCESSING    // claimed; claimedAt says since when
  DONE          // aligned, version known, boxes cropped
  NEEDS_VERSION // aligned, but the version could not be told; a person picks it
  FAILED        // gave up after retries; `error` says why
}

model QuizPage {
  id            String         @id @default(cuid())
  batchId       String
  batch         QuizBatch      @relation(fields: [batchId], references: [id], onDelete: Cascade)
  // 0-based position in the upload.
  index         Int
  status        QuizPageStatus @default(PENDING)
  attempts      Int            @default(0)
  claimedAt     DateTime?
  // Set by the professor when detection could not tell, or got it wrong.
  versionForced String?
  version       String?
  // How the page was lined up ("markers", "lines", "paper edges") and how well the
  // form's printed lines matched afterwards (0-1).
  method        String?
  markers       Int?
  match         Float?
  // Each version's fit from detection, e.g. {"A": 0.99, "B": 0.42}.
  fits          Json?
  // Per box: [{ id, ink, blank }]. Crops are files beside the page image.
  slots         Json?
  error         String?
  createdAt     DateTime       @default(now())
  updatedAt     DateTime       @updatedAt

  // ── Grading (after the page is DONE) ──
  gradeStatus    QuizGradeStatus @default(NONE)
  gradeClaimedAt DateTime?
  gradeAttempts  Int             @default(0)
  gradeError     String?
  gradedAt       DateTime?
  // What the model said, kept so the page can be re-scored against an edited key
  // without asking again: { text: { [slotId]: TextRead }, structure: { [slotId]: StructureRead } }.
  reads          Json?
  // Tokens per model call, for cost: [{ model, input_tokens, output_tokens, cached }].
  usage          Json?
  pointsAuto     Float?
  maxPoints      Float?
  toReview       Int?
  results        QuizSlotResult[]
  overrides      QuizOverride[]

  @@unique([batchId, index])
  @@index([status])
  @@index([gradeStatus])
}

enum QuizGradeStatus {
  NONE     // not graded (not DONE yet, or grading not set up)
  PENDING  // waiting for the grader
  GRADING  // claimed; gradeClaimedAt says since when
  GRADED
  FAILED   // gave up after retries; gradeError says why
}

// One answer box on one paper, scored. Recomputed from QuizPage.reads whenever the key
// changes; the model is not asked again.
model QuizSlotResult {
  id            String   @id @default(cuid())
  pageId        String
  page          QuizPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slotId        String
  kind          String   // enzyme | cofactors | structure
  status        String   // blank | read | illegible | error
  blankBy       String?  // ink | model
  transcription String?
  // What identical answers share, for reviewing by item: the normalised name, or the
  // sorted cofactors with their sides. Null for structures.
  groupKey      String?
  // The rest of the scoring detail (match, cofactors, features, description).
  detail        Json
  confidence    Float
  pointsAuto    Float
  maxPoints     Float
  needsReview   Boolean
  reviewReasons Json
  createdAt     DateTime @default(now())

  @@unique([pageId, slotId])
  @@index([slotId, groupKey])
}

// Model reads by (model, prompt version, prompt, images), so re-running a page never
// pays twice. Holds transcriptions of student answers (never names), like the reads above.
model QuizReadCache {
  key       String   @id
  value     Json
  createdAt DateTime @default(now())
}

// One row per running Pulse server, refreshed every 30 seconds. Scan images live on each
// server's own disk, so two servers working from one database split a batch's pages
// between two disks, and each shows the other's pages as missing. This is how the app
// notices and says so. Rows are never read for anything else.
model QuizServer {
  id        String   @id
  label     String
  uploadDir String
  seenAt    DateTime
}

// ─── Review (Phase 5) ─────────────────────────────────────────────────────────
//
// A box's score is, in order: the professor's decision for that one paper
// (QuizOverride), else their decision for everyone who wrote the same thing
// (QuizGroupDecision), else the automatic score (QuizSlotResult.pointsAuto). Decisions
// live apart from results, so re-scoring after a key edit never erases them.

// "Everyone who wrote this, in this box, gets these points." Applies to papers uploaded
// later with the same answer too.
model QuizGroupDecision {
  id           String      @id @default(cuid())
  assessmentId String
  assessment   QuizContent @relation(fields: [assessmentId], references: [id], onDelete: Cascade)
  slotId       String
  // QuizSlotResult.groupKey: the normalised answer.
  groupKey     String
  points       Float
  decidedById  String
  decidedAt    DateTime    @default(now())

  @@unique([assessmentId, slotId, groupKey])
}

// One paper's box, decided by hand: a regrade, a structure judged feature by feature, or
// an exception to its group.
model QuizOverride {
  id          String   @id @default(cuid())
  pageId      String
  page        QuizPage @relation(fields: [pageId], references: [id], onDelete: Cascade)
  slotId      String
  points      Float
  // Structures: the professor's feature answers, in the key's order.
  features    Json?
  note        String?
  decidedById String
  decidedAt   DateTime @default(now())

  @@unique([pageId, slotId])
}

// Every review decision, appended and never edited: who, when, which box or group, and
// the score before and after. No foreign keys, so the record outlives what it describes.
model QuizDecisionLog {
  id           String   @id @default(cuid())
  assessmentId String
  professorId  String
  // "group" | "paper" | "alias" (an answer added to the key from review)
  scope        String
  slotId       String
  groupKey     String?
  pageId       String?
  // Points before and after; null after = the decision was withdrawn.
  fromPoints   Float?
  toPoints     Float?
  papers       Int?
  detail       Json?
  createdAt    DateTime @default(now())

  @@index([assessmentId, createdAt])
}
