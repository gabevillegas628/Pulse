generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

model Professor {
  id           String   @id @default(cuid())
  email        String   @unique
  passwordHash String
  name         String
  createdAt    DateTime @default(now())
  updatedAt    DateTime @updatedAt
  classes      Class[]
}

model Student {
  id           String              @id @default(cuid())
  netId        String              @unique
  email        String              @unique
  passwordHash String
  createdAt    DateTime            @default(now())
  updatedAt    DateTime            @updatedAt
  enrollments  Enrollment[]
  responses    Response[]
  extensions   DeadlineExtension[]
}

model Class {
  id                String         @id @default(cuid())
  professorId       String
  professor         Professor      @relation(fields: [professorId], references: [id], onDelete: Cascade)
  name              String
  description       String?
  joinCode          String         @unique
  textbookRepo      String?
  textbookPath      String?
  textbookBranch    String?
  // Default for live AI theming of FREE_TEXT answers. Per-question `liveThemes`
  // overrides it; off by default so no lecture starts calling an LLM unasked.
  liveThemesDefault Boolean        @default(false)
  // Default for auto-closing questions once answers stop arriving. Per-question
  // `autoClose` overrides it; off by default so no lecture starts refusing answers unasked.
  autoCloseDefault  Boolean        @default(false)
  createdAt         DateTime       @default(now())
  updatedAt         DateTime       @updatedAt
  sessions          Session[]
  assignments       Assignment[]
  enrollments       Enrollment[]
  sections          Section[]
  textbookViews     TextbookView[]
}

model TextbookView {
  id              String   @id @default(cuid())
  classId         String
  class           Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  chapterFilename String
  viewedAt        DateTime @default(now())

  @@index([classId])
  @@index([classId, chapterFilename])
}

model Section {
  id          String       @id @default(cuid())
  classId     String
  class       Class        @relation(fields: [classId], references: [id], onDelete: Cascade)
  name        String
  joinCode    String       @unique
  createdAt   DateTime     @default(now())
  enrollments Enrollment[]
  runs        SessionRun[]
}

model Enrollment {
  studentId  String
  classId    String
  sectionId  String?
  student    Student  @relation(fields: [studentId], references: [id], onDelete: Cascade)
  class      Class    @relation(fields: [classId], references: [id], onDelete: Cascade)
  section    Section? @relation(fields: [sectionId], references: [id])
  enrolledAt DateTime @default(now())

  @@id([studentId, classId])
}

// ─── IN_CLASS ─────────────────────────────────────────────────────────────────

model Session {
  id         String          @id @default(cuid())
  classId    String
  class      Class           @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  accessCode String          @unique
  status     SessionStatus   @default(DRAFT)
  createdAt  DateTime        @default(now())
  updatedAt  DateTime        @updatedAt
  questions  Question[]
  groups     QuestionGroup[]
  runs       SessionRun[]
}

model SessionRun {
  id        String        @id @default(cuid())
  sessionId String
  session   Session       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  sectionId String?
  section   Section?      @relation(fields: [sectionId], references: [id])
  status    SessionStatus @default(OPEN)
  openedAt  DateTime      @default(now())
  closedAt  DateTime?
  createdAt DateTime      @default(now())
  responses Response[]
  themeSets ThemeSet[]

  @@index([sessionId])
  @@index([sectionId])
}

// ─── HOMEWORK ─────────────────────────────────────────────────────────────────

model Assignment {
  id         String              @id @default(cuid())
  classId    String
  class      Class               @relation(fields: [classId], references: [id], onDelete: Cascade)
  title      String
  status     SessionStatus       @default(OPEN)
  deadline   DateTime?
  createdAt  DateTime            @default(now())
  updatedAt  DateTime            @updatedAt
  questions  Question[]
  groups     QuestionGroup[]
  extensions DeadlineExtension[]
}

model DeadlineExtension {
  id           String     @id @default(cuid())
  assignmentId String
  studentId    String
  deadline     DateTime
  createdAt    DateTime   @default(now())
  assignment   Assignment @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  student      Student    @relation(fields: [studentId], references: [id], onDelete: Cascade)

  @@unique([assignmentId, studentId])
  @@index([assignmentId])
}

model QuestionGroup {
  id           String      @id @default(cuid())
  sessionId    String?
  session      Session?    @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentId String?
  assignment   Assignment? @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  title        String
  text         String?
  order        Int
  createdAt    DateTime    @default(now())
  questions    Question[]

  @@index([sessionId])
  @@index([assignmentId])
}

// ─── Shared ───────────────────────────────────────────────────────────────────

enum SessionStatus {
  DRAFT
  OPEN
  CLOSED
  ARCHIVED
}

enum QuestionType {
  FREE_TEXT
  MULTIPLE_CHOICE
  RATING
  YES_NO
  NUMERIC
  MULTI_SELECT
  ORDERING
  STRUCTURE
}

model Question {
  id            String         @id @default(cuid())
  sessionId     String?
  session       Session?       @relation(fields: [sessionId], references: [id], onDelete: Cascade)
  assignmentId  String?
  assignment    Assignment?    @relation(fields: [assignmentId], references: [id], onDelete: Cascade)
  groupId       String?
  group         QuestionGroup? @relation(fields: [groupId], references: [id])
  title         String?
  text          String
  type          QuestionType   @default(FREE_TEXT)
  options       Json?
  order         Int
  accessCode    String         @unique
  correctAnswer String?
  tolerance     Float?
  unit          String?
  // null = inherit Class.liveThemesDefault. FREE_TEXT only; ignored for other types.
  liveThemes    Boolean?
  // null = inherit Class.autoCloseDefault. Unlike liveThemes this applies to every
  // question type — the answer key is most worth protecting on the objective ones.
  autoClose     Boolean?
  responses     Response[]
  themeSets     ThemeSet[]

  @@index([sessionId])
  @@index([assignmentId])
  @@index([groupId])
}

model Response {
  id           String         @id @default(cuid())
  questionId   String
  studentId    String
  runId        String?
  question     Question       @relation(fields: [questionId], references: [id], onDelete: Cascade)
  student      Student        @relation(fields: [studentId], references: [id], onDelete: Cascade)
  run          SessionRun?    @relation(fields: [runId], references: [id])
  responseText String
  wordCount    Int
  isFlagged    Boolean        @default(false)
  aiScore      Float?
  isDraft      Boolean        @default(true)
  submittedAt  DateTime       @default(now())
  theme        ResponseTheme?

  @@unique([questionId, studentId])
  @@index([questionId])
  @@index([runId])
  @@index([studentId])
}

// ─── Live AI themes ───────────────────────────────────────────────────────────
//
// Categories for a FREE_TEXT question, derived once from the first answers and then
// assigned to each subsequent answer as it lands. See live_ai_themes_spec.md.
//
// Keyed to the run, not the question: re-teaching the same session next term starts
// from a clean set rather than inheriting last term's categories.

enum ThemeSetStatus {
  WAITING // enabled, not enough answers yet
  BOOTSTRAPPING // deriving categories now
  ACTIVE // categories exist, classifying incrementally
  RECLUSTERING // re-deriving categories
  FAILED // gave up; the projector falls back to plain counts
}

enum ThemeSource {
  AI
  PROFESSOR
}

model ThemeSet {
  id              String          @id @default(cuid())
  questionId      String
  runId           String
  question        Question        @relation(fields: [questionId], references: [id], onDelete: Cascade)
  run             SessionRun      @relation(fields: [runId], references: [id], onDelete: Cascade)
  status          ThemeSetStatus  @default(WAITING)
  model           String? // which model produced the categories, for the record
  bootstrapN      Int? // how many answers seeded it
  classifyCalls   Int             @default(0) // cost ceiling counter
  lastClusteredAt DateTime?
  createdAt       DateTime        @default(now())
  updatedAt       DateTime        @updatedAt
  categories      ThemeCategory[]

  @@unique([questionId, runId])
  @@index([runId])
}

model ThemeCategory {
  id          String          @id @default(cuid())
  themeSetId  String
  themeSet    ThemeSet        @relation(fields: [themeSetId], references: [id], onDelete: Cascade)
  label       String
  description String
  order       Int
  // Exactly one per set, created server-side and never invented by the model.
  // Low-confidence answers land here instead of being forced into a wrong bin.
  isOther     Boolean         @default(false)
  assignments ResponseTheme[]

  @@index([themeSetId])
}

// A response's category assignment. Deliberately a separate table rather than a column
// on Response: Response is hot and widely selected — including by the identity-stripped
// /addin/live payload — so an AI-feature foreign key there would widen every query that
// touches it. Counts come from a groupBy here, so they can never go stale.
model ResponseTheme {
  id         String        @id @default(cuid())
  responseId String        @unique
  categoryId String
  response   Response      @relation(fields: [responseId], references: [id], onDelete: Cascade)
  category   ThemeCategory @relation(fields: [categoryId], references: [id], onDelete: Cascade)
  confidence Float?
  source     ThemeSource   @default(AI)
  assignedAt DateTime      @default(now())

  @@index([categoryId])
}
