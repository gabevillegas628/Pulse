PORT=3001
NODE_ENV=development
DATABASE_URL=postgresql://user:password@localhost:5432/pulse
JWT_SECRET=change-me-use-openssl-rand-hex-32
JWT_EXPIRES_IN=24h
BASE_URL=http://localhost:5173
FRONTEND_URL=http://localhost:5173
ANTHROPIC_API_KEY=sk-ant-...

# Transactional email (student "forgot password"). Both must be set for mail to go
# out; EMAIL_USER has to be a sender address verified in the Brevo account, or Brevo
# refuses the send. Leave them blank in development and the reset link is printed to
# the server log instead of emailed.
BREVO_API_KEY=xkeysib-...
EMAIL_USER=pulse@yourdomain.edu
EMAIL_FROM_NAME=Pulse
# Minutes an emailed reset link stays good. Defaults to 60.
PASSWORD_RESET_TTL_MINUTES=60
